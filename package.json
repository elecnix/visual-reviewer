{
  "name": "visual-reviewer",
  "version": "0.1.0",
  "description": "AI semantic test oracle for Playwright — independent verdicts on green tests, evidence-backed.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/playwright/reporter.d.ts",
      "import": "./dist/playwright/reporter.js"
    },
    "./playwright": {
      "types": "./dist/playwright/test.d.ts",
      "import": "./dist/playwright/test.js"
    }
  },
  "bin": {
    "visual-reviewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "testing",
    "ai",
    "test-oracle",
    "llm",
    "qa"
  ],
  "peerDependencies": {
    "@playwright/test": "^1.45.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
